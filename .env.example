# Copy to .env (never commit .env), or generate the URLs with: python cli.py endpoints --write-env
# Host ports for Jaeger, OpenSearch and Grafana are dynamic and change whenever the stack restarts.
# Prometheus is published on host port 9090 by compose.observability.yaml
PROM_URL=http://localhost:9090
# Jaeger query port directly (docker port jaeger 16686), so a frontend-proxy fault does not hide traces.
# The frontend proxy (http://localhost:8080) also works while it is healthy.
JAEGER_URL=
# docker port opensearch 9200 -> e.g. 0.0.0.0:55012 -> OPENSEARCH_URL=http://localhost:55012
OPENSEARCH_URL=
# Browser only (docker port grafana 3000)
GRAFANA_URL=
EVIDENCE_DIR=evidence
TELEMETRY_TIMEOUT_S=10

# LLM through LangChain. Default: Google Gemini free tier (key from https://aistudio.google.com/apikey).
# Test with: python cli.py check-llm. Free daily quotas differ a lot per model: the newest Flash models allowed only
# ~20 requests/day on our key (one investigation uses up to 6), Flash-Lite allows far more. On 503/429/504 the agent
# switches to LLM_FALLBACK_MODEL at once, then retries with growing waits (8, 16, 32, 64 s), alternating the two models, while the time budget allows.
LLM_PROVIDER=google_genai
LLM_MODEL=gemini-3.1-flash-lite
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
GOOGLE_API_KEY=
# Alternative free tier: Groq (key from https://console.groq.com/keys)
# LLM_PROVIDER=groq
# LLM_MODEL=
# GROQ_API_KEY=

# Grafana (Team 6's own instance from grafana/compose.yaml, NOT the organisers' Grafana).
# Each investigation is posted there as an annotation. Empty GRAFANA_URL = disabled.
GRAFANA_URL=http://localhost:3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=incident-agent
# Team Action API (python cli.py action-api init-token adds the first two if absent; never commit the token)
ACTION_API_URL=http://127.0.0.1:8787
# ACTION_API_TOKEN=  (>= 24 chars, shared by the agent and the Action API)
# simulate (default, changes nothing) | docker (real `docker restart` of allowlisted app containers)
ACTION_API_EXECUTOR=simulate
ACTION_API_COMPOSE_PROJECT=opentelemetry-demo-team_6
# Optional stateful/edge targets, off by default: valkey-cart,astronomy-db,kafka,frontend-proxy
ACTION_API_EXTRA_TARGETS=
# ACTION_API_STATE_DIR=runs/action_api

# Organiser Action API via catalog file (see ACTION_API.md); not needed for the team API.
# Without it, remediation always escalates. Live dispatch also needs provenance "organiser" and the base URL.
ACTION_API_CATALOG=
# Optional, if the contract requires a token (the env var name is set in the catalog's token_env)
# ACTION_API_TOKEN=
# Operator kill switch: 1 blocks every state-changing action (or: python cli.py kill-switch on)
INCIDENT_AGENT_KILL_SWITCH=0
INCIDENT_AGENT_APPROVER=
