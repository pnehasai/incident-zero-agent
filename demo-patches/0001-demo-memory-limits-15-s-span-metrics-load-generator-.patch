From 888902e25763a98de4d9159a12e3b120a796e1d0 Mon Sep 17 00:00:00 2001
From: pnehasai <neha.padarthi@gmail.com>
Date: Wed, 4 Nov 2026 23:46:07 +0530
Subject: [PATCH] demo: memory limits, 15 s span metrics, load generator skips
 missing agent

- checkout/product-catalog 20M -> 128M (GOMEMLIMIT 100MiB), payment 140M -> 256M: GC thrash at 300-400% CPU
- span_metrics flush every 15 s (was 60 s) for faster detection
- load generator: ask_agent task only when LOCUST_AGENT_ENABLED=true (agent lives in compose.agent.yaml);
  locustfile mounted so edits apply on restart

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 compose.yaml                          | 13 ++++++++-----
 src/load-generator/locustfile.py      |  3 +++
 src/otel-collector/otelcol-config.yml |  1 +
 3 files changed, 12 insertions(+), 5 deletions(-)

diff --git a/compose.yaml b/compose.yaml
index c82d9464..99ffbf4b 100644
--- a/compose.yaml
+++ b/compose.yaml
@@ -124,7 +124,7 @@ services:
     deploy:
       resources:
         limits:
-          memory: 20M
+          memory: 128M
     restart: unless-stopped
     ports:
       - "${CHECKOUT_PORT}"
@@ -138,7 +138,7 @@ services:
       - PAYMENT_ADDR
       - PRODUCT_CATALOG_ADDR
       - SHIPPING_ADDR
-      - GOMEMLIMIT=16MiB
+      - GOMEMLIMIT=100MiB
       - OTEL_EXPORTER_OTLP_ENDPOINT=http://${OTEL_COLLECTOR_HOST}:${OTEL_COLLECTOR_PORT_HTTP}
       - OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
       - OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE
@@ -429,6 +429,8 @@ services:
       resources:
         limits:
           memory: 1500M
+    volumes:
+      - ./src/load-generator/locustfile.py:/usr/src/app/locustfile.py:ro
     restart: unless-stopped
     ports:
       - "${LOCUST_WEB_PORT}"
@@ -439,6 +441,7 @@ services:
       - LOCUST_HEADLESS
       - LOCUST_AUTOSTART
       - LOCUST_BROWSER_TRAFFIC_ENABLED=true
+      - LOCUST_AGENT_ENABLED=${LOCUST_AGENT_ENABLED:-false}
       - LOCUST_HTTP_USER_WEIGHT
       - LOCUST_BROWSER_USER_WEIGHT
       - OTEL_EXPORTER_OTLP_ENDPOINT
@@ -477,7 +480,7 @@ services:
     deploy:
       resources:
         limits:
-          memory: 140M
+          memory: 256M
     restart: unless-stopped
     ports:
       - "${PAYMENT_PORT}"
@@ -526,7 +529,7 @@ services:
     deploy:
       resources:
         limits:
-          memory: 20M
+          memory: 128M
     restart: unless-stopped
     ports:
       - "${PRODUCT_CATALOG_PORT}"
@@ -534,7 +537,7 @@ services:
       - PRODUCT_CATALOG_PORT
       - FLAGD_HOST
       - FLAGD_PORT
-      - GOMEMLIMIT=16MiB
+      - GOMEMLIMIT=100MiB
       - OTEL_EXPORTER_OTLP_ENDPOINT
       - OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE
       - OTEL_EXPORTER_OTLP_METRICS_DEFAULT_HISTOGRAM_AGGREGATION
diff --git a/src/load-generator/locustfile.py b/src/load-generator/locustfile.py
index 1810a35f..60b43c63 100644
--- a/src/load-generator/locustfile.py
+++ b/src/load-generator/locustfile.py
@@ -237,6 +237,9 @@ class WebsiteUser(HttpUser):
 
     @task(3)
     def ask_agent(self):
+        # The agent service lives in compose.agent.yaml; without it every call fails with a DNS error.
+        if os.environ.get("LOCUST_AGENT_ENABLED", "false").lower() != "true":
+            return
         prompt = random.choice(agent_prompts)
         input_messages = json.dumps([{"role": "user", "parts": [{"type": "text", "content": prompt}]}])
         with self.tracer.start_as_current_span("user_ask_agent", context=context.get_current(), attributes={"gen_ai.input.messages": input_messages}):
diff --git a/src/otel-collector/otelcol-config.yml b/src/otel-collector/otelcol-config.yml
index 802e0ea1..0af6906f 100644
--- a/src/otel-collector/otelcol-config.yml
+++ b/src/otel-collector/otelcol-config.yml
@@ -253,6 +253,7 @@ processors:
 
 connectors:
   span_metrics:
+    metrics_flush_interval: 15s
 
 service:
   pipelines:
-- 
2.47.0.windows.1

